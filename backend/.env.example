SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
TELEGRAM_BOT_TOKEN=
BOT_SHARED_SECRET=changeme
FRONTEND_WEBAPP_URL=https://example.com

# ── Postgres options (pick ONE of the two blocks below) ─────────────────────

# Option A — Neon / managed Postgres (Render prod): supersedes DB_NAME block
# DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Option B — per-var Postgres (local docker-compose)
# DB_NAME=marketbot
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ── CORS / CSRF (leave blank for local allow-all) ───────────────────────────
# CORS_ALLOWED_ORIGINS=https://your-app.netlify.app
# CSRF_TRUSTED_ORIGINS=https://your-app.netlify.app,https://your-backend.onrender.com
