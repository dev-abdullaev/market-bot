# Copy this file to .env and fill in real values before running docker compose.
# cp .env.example .env

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*

# ── Postgres (matches the db service defaults in docker-compose.yml) ─────────
DB_NAME=marketbot
DB_USER=postgres
DB_PASSWORD=postgres
# DB_HOST=db      (inside compose network — use this when running via docker compose)
# DB_HOST=127.0.0.1 (from host, e.g. for make test-pg)
DB_HOST=db
# Host port for the db service is 5434 (5432 is used by another project on this machine).
# Inside the compose network always use 5432.
DB_PORT=5432

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
